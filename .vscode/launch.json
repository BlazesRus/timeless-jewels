{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: Main (launch)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}\\node_modules\\.bin\\electron.cmd"
      },
      "runtimeArgs": [
        "--inspect=9229",
        "--remote-debugging-port=9222",
        "."
      ],
      "env": {
        "VITE_DEV_SERVER_URL": "http://localhost:5173"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "pnpm: dev"
    },
    {
      "name": "Electron: Main (attach)",
      "type": "pwa-node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Renderer: Attach (Chrome 9222)",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "urlFilter": "http://localhost:5173/*",
      "timeout": 30000
    },
    {
      "name": "Electron: App (built)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}\\node_modules\\.bin\\electron.cmd"
      },
      "cwd": "${workspaceFolder}",
      "args": ["dist/ElectronApp"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Dev: Electron + Renderer",
      "configurations": [
        "Electron: Main (launch)",
        "Renderer: Attach (Chrome 9222)"
      ],
      "stopAll": true
    }
  ]
}
