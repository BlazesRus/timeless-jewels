{
  "name": "timeless-jewels-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend",
    "frontend/ElectronHybridTester",
    "packages/vite-plugin-svelte/packages/vite-plugin-svelte",
		"frontend/modules/*"
  ],
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:tester": "pnpm --filter tester dev"
  },
  "pnpm": {
    "overrides": {
      "svelte@<5.34.8": "^5.34.8",
      "vite@<4.3.0": "^4.3.0",
      "typescript@<5.2.0": "^5.2.0",
      "@types/node@<24.0.4": "^24.0.4",
      "@sveltejs/kit@<1.4.0": "^1.4.0",
      "eslint@<8.0.0": "^8.0.0",
      "@typescript-eslint/parser@<6.0.0": "^6.0.0",
      "@typescript-eslint/eslint-plugin@<6.0.0": "^6.0.0",
      "@eslint-community/eslint-utils@<4.7.0": "^4.7.0",
      "send@<0.19.0": "^0.19.1",
      "@sveltejs/kit>cookie@<0.7.0": "^0.7.2"
    },
    "peerDependencyRules": {
      "ignoreMissing": [],
      "allowAny": []
    }
  }
}